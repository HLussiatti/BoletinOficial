{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {"source": "/", "destination": "/api/index"}
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{tests/**,historico/**,tmp/**,var/**,data/**,scripts/**,config/**,dist/**,build/**,.venv/**,**/*.egg-info/**,**/__pycache__/**,**/*.sqlite3,**/*.pdf,**/*.eml,**/*.xlsx,**/*.ipynb}"
    }
  }
}
